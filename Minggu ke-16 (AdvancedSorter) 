from typing import List, Optional
import math

class ListNode:
    def __init__(self, data, next=None):
        self.data = data
        self.next = next

class AdvancedSorter:
    def __init__(self):
        pass

    # =========================================================
    # 1. ARRAY MERGE SORT (Virtual Sublists + Single tmpArray)
    # =========================================================
    def sort_array(self, arr: List[int]) -> List[int]:
        if len(arr) <= 1: 
            return arr
        tmp_array = [0] * len(arr) # Single temporary array
        self._rec_merge_sort(arr, 0, len(arr) - 1, tmp_array)
        return arr

    def _rec_merge_sort(self, arr, first, last, tmp_array):
        if first >= last: 
            return
        mid = (first + last) // 2
        self._rec_merge_sort(arr, first, mid, tmp_array)
        self._rec_merge_sort(arr, mid + 1, last, tmp_array)
        self._merge_virtual(arr, first, mid, last, tmp_array)

    def _merge_virtual(self, arr, left_start, mid, right_end, tmp_array):
        # Implementasi penggabungan dua virtual sublist yang bersebelahan
        left = left_start
        right = mid + 1
        idx = left_start

        while left <= mid and right <= right_end:
            # Menggunakan <= untuk memastikan pengurutan STABLE
            if arr[left] <= arr[right]: 
                tmp_array[idx] = arr[left]
                left += 1
            else:
                tmp_array[idx] = arr[right]
                right += 1
            idx += 1

        # Menyalin sisa elemen dari sublist kiri (jika ada)
        while left <= mid:
            tmp_array[idx] = arr[left]
            left += 1
            idx += 1

        # Menyalin sisa elemen dari sublist kanan (jika ada)
        while right <= right_end:
            tmp_array[idx] = arr[right]
            right += 1
            idx += 1

        # Salin kembali hasil dari tmp_array ke array asli
        for i in range(left_start, right_end + 1):
            arr[i] = tmp_array[i]

    # =========================================================
    # 2. LINKED LIST MERGE SORT (Fast-Slow + Dummy Merge)
    # =========================================================
    def sort_linked_list(self, head: Optional[ListNode]) -> Optional[ListNode]:
        if head is None or head.next is None:
            return head
            
        right_head = self._split_linked_list(head)
        left_head = head
        
        left_sorted = self.sort_linked_list(left_head)
        right_sorted = self.sort_linked_list(right_head)
        
        return self._merge_linked_lists(left_sorted, right_sorted)

    def _split_linked_list(self, head: ListNode) -> Optional[ListNode]:
        if not head: 
            return None
            
        midPoint = head
        curNode = head.next
        
        # Fast-slow pointer: midPoint bergerak 1, curNode bergerak 2 langkah
        while curNode and curNode.next:
            midPoint = midPoint.next
            curNode = curNode.next.next
            
        right_head = midPoint.next
        midPoint.next = None # Memutus list menjadi dua bagian
        
        return right_head

    def _merge_linked_lists(self, listA: Optional[ListNode], listB: Optional[ListNode]) -> Optional[ListNode]:
        # Menggunakan dummy node dan tail reference untuk merge in-place
        dummy = ListNode(0)
        tail = dummy
        
        while listA and listB:
            # Gunakan <= untuk mempertahankan STABILITAS
            if listA.data <= listB.data:
                tail.next = listA
                listA = listA.next
            else:
                tail.next = listB
                listB = listB.next
            tail = tail.next
            
        # Sambungkan sisa list yang masih ada
        if listA:
            tail.next = listA
        if listB:
            tail.next = listB
            
        return dummy.next

    # =========================================================
    # 3. QUICK SORT PARTITION (Median-of-Three Pivot)
    # =========================================================
    def partition_quick(self, arr: List[int], first: int, last: int) -> int:
        mid = (first + last) // 2
        
        # Mengurutkan elemen first, mid, dan last untuk menemukan median
        if arr[first] > arr[mid]: arr[first], arr[mid] = arr[mid], arr[first]
        if arr[first] > arr[last]: arr[first], arr[last] = arr[last], arr[first]
        if arr[mid] > arr[last]: arr[mid], arr[last] = arr[last], arr[mid]
        
        # Pindahkan median ke posisi 'first' sebagai pivot
        arr[first], arr[mid] = arr[mid], arr[first]
        pivot = arr[first]
        
        left = first + 1
        right = last
        
        # Catatan Stabilitas: Quick Sort in-place dengan teknik swapping dari dua ujung 
        # (seperti ini) secara bawaan adalah UNSTABLE. Memaksakan stabilitas pada Quick Sort in-place 
        # membutuhkan memori ekstra O(n) atau overhead komputasi signifikan, yang melanggar batasan sistem.
        done = False
        while not done:
            while left <= right and arr[left] <= pivot:
                left += 1
            while right >= left and arr[right] >= pivot:
                right -= 1
                
            if right < left:
                done = True
            else:
                arr[left], arr[right] = arr[right], arr[left]
                
        arr[first], arr[right] = arr[right], arr[first]
        return right
